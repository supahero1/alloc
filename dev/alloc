def resolve_path(path_str: str) -> Path:
	try:
		return Path(path_str).resolve()
	except Exception:
		return Path(path_str).absolute()

def find_repo_root() -> Path:
	candidate: Path = Path(__file__).resolve().parent.parent
	if (candidate / "Makefile").is_file() and (candidate / "dev").is_dir():
		return candidate
	candidate = Path.cwd()
	for p in [candidate] + list(candidate.parents):
		if (p / "Makefile").is_file() and (p / "dev").is_dir():
			return p
	sys.exit("not in alloc repository root context")

