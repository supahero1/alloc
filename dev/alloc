_BENCH_LOG_DEDUPE: Set[str] = set()
_TAG_PLAIN: str = "[alloc]"
_TAG_STYLED: str = "\033[1;36m[alloc]\033[0m"

def status_line(text: str) -> None:
	global _STATUS_LAST_LEN
	if sys.stderr.isatty():
		msg: str = f"{_TAG_STYLED} {text}"
		visible_msg: str = f"{_TAG_PLAIN} {text}"
		pad: str = ""
		if _STATUS_LAST_LEN > len(visible_msg):
			pad = " " * (_STATUS_LAST_LEN - len(visible_msg))
		print("\r" + msg + pad, end="", file=sys.stderr, flush=True)
		_STATUS_LAST_LEN = len(visible_msg)
	else:
		msg: str = f"{_TAG_PLAIN} {text}"
		print(msg, file=sys.stderr)

def status_detach() -> None:
	global _STATUS_LAST_LEN
	if sys.stderr.isatty() and _STATUS_LAST_LEN:
		print(file=sys.stderr, flush=True)
	_STATUS_LAST_LEN = 0

def status_done() -> None:
	status_detach()

def status_run(*args: Any, **kwargs: Any) -> subprocess.CompletedProcess:
	status_detach()
	return subprocess.run(*args, **kwargs)

def init_perf_events() -> Tuple[str, bool]:
	global _PERF_EVENTS, _SYSCALLS_AVAILABLE
	if _PERF_EVENTS is not None:
		return _PERF_EVENTS, _SYSCALLS_AVAILABLE
	if IS_WINDOWS:
		_PERF_EVENTS = ""
		_SYSCALLS_AVAILABLE = False
		return _PERF_EVENTS, _SYSCALLS_AVAILABLE
	_PERF_EVENTS = "task-clock,page-faults"
	for ev in ["raw_syscalls:sys_enter", "syscalls:sys_enter_mmap", "syscalls:sys_enter_openat"]:
		res: subprocess.CompletedProcess = subprocess.run(["perf", "stat", "-x,", "-e", ev, "--", "/bin/true"], stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
		if res.returncode == 0:
			_PERF_EVENTS = f"{ev},{_PERF_EVENTS}"
			_SYSCALLS_AVAILABLE = True
			break
	return _PERF_EVENTS, _SYSCALLS_AVAILABLE

def maybe_open_html(path: Path, should_open: bool) -> None:
	print(f"open: file://{path.resolve()}")
	if should_open:
		opener: str = "open" if sys.platform == "darwin" else "xdg-open"
		if shutil.which(opener):
			subprocess.run([opener, str(path)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def sanitize_label(label: Optional[str]) -> str:
	if not label:
		return "run"
	sanitized: str = "".join(c if c.isalnum() or c in "._-" else "_" for c in label).strip("_")
	return sanitized if sanitized else "run"

def ensure_runs_dir() -> None:
	RUNS_DIR.mkdir(parents=True, exist_ok=True)
	COMPARE_DIR.mkdir(parents=True, exist_ok=True)

def ensure_bench_bins() -> None:
	prefixes: List[str] = ["bench_detailed_other", "bench_detailed_alloc"]
	if IS_WINDOWS:
		prefixes.extend(["bench_detailed_jemalloc", "bench_detailed_mimalloc", "bench_detailed_tbbmalloc"])

	missing: List[Path] = []
	for prefix in prefixes:
		for name in BENCH_BINARY_NAMES:
			path: Path = BIN_DIR / f"{prefix}_{name}{EXE_SUFFIX}"
			if not path.is_file():
				missing.append(path)

	if missing:
		status_line("building: bench binaries")
		subprocess.run(["make", "-C", str(ROOT_DIR), "build_dev_bench"], check=False, stdout=subprocess.DEVNULL)

	missing = []
	for prefix in prefixes:
		for name in BENCH_BINARY_NAMES:
			path = BIN_DIR / f"{prefix}_{name}{EXE_SUFFIX}"
			if not path.is_file():
				missing.append(path)

	if missing:
		status_done()
		sys.exit(f"missing bench binaries in {BIN_DIR}: {', '.join(p.name for p in missing[:4])}")

def ensure_report_script() -> None:
	if not REPORT_SCRIPT.is_file():
		status_done()
		sys.exit(f"missing {REPORT_SCRIPT}")

def list_run_names() -> List[str]:
	if not RUNS_DIR.is_dir():
		return []
	dirs: List[str] = [d.name for d in RUNS_DIR.iterdir() if d.is_dir() and d.name != "comparisons"]
	return sorted(dirs, reverse=True)

def list_comparison_bases() -> List[str]:
	if not COMPARE_DIR.is_dir():
		return []
	files: Set[str] = {f.stem for f in COMPARE_DIR.iterdir() if f.is_file() and f.suffix in (".txt", ".html")}
	return sorted(list(files), reverse=True)

def resolve_run_token(token: Optional[str]) -> Optional[str]:
	if not token:
		return None
	names: List[str] = list_run_names()
	if not names:
		return None
	if token.isdigit():
		idx: int = int(token)
		if 1 <= idx <= len(names):
			return names[idx - 1]
		return None
	if token in names:
		return token
	return None

def resolve_run_token_or_exit(token: Optional[str]) -> str:
	name: Optional[str] = resolve_run_token(token)
	if not name:
		print(f"run not found: {token}", file=sys.stderr)
		cmd_bench_list()
		sys.exit(2)
	return name

def default_sections() -> List[str]:
	ops_sizes_small: List[str] = ["8b", "16b", "64b", "256b", "1kib", "4kib", "64kib"]
	ops_sizes_with_large: List[str] = ops_sizes_small + ["128kib", "256kib", "512kib", "1mib"]
	ops_kinds_with_large: List[str] = ["malloc", "free", "malloc_hot", "free_hot"]
	ops_kinds_small: List[str] = ["calloc", "calloc_hot", "pair", "realloc_small", "realloc_grow_end", "realloc_grow_middle", "realloc_shrink", "realloc_class_jump"]

	sections: List[str] = ["rss_16b", "rss_64b", "rss_256b", "rss_1kib", "rss_4kib", "reclaim", "frag_32b", "frag_128b", "frag_512b", "frag_2kib"]
	for kind in ops_kinds_with_large:
		for size in ops_sizes_with_large:
			sections.append(f"ops_{kind}_{size}")
	for kind in ops_kinds_small:
		for size in ops_sizes_small:
			sections.append(f"ops_{kind}_{size}")
	for size in ["8b", "16b", "64b", "256b", "1kib", "4kib"]:
		sections.append(f"ops_aligned_malloc_{size}")
		sections.append(f"ops_aligned_free_{size}")
	sections.extend(["first_16b", "first_4kib", "first_1mib"])
	sections.extend(["handoff_8b", "handoff_16b", "handoff_64b", "handoff_256b", "handoff_1kib", "handoff_4kib"])
	sections.extend(["app_mt", "app_st"])
	for size in ["16b", "64b", "256b", "1kib"]:
		sections.append(f"locality_{size}")
	return sections

def parse_size_token(size_str: str) -> int:
	if size_str.endswith("mib"):
		return int(size_str[:-3]) * 1024 * 1024
	if size_str.endswith("kib"):
		return int(size_str[:-3]) * 1024
	if size_str.endswith("b"):
		return int(size_str[:-1])
	raise ValueError(f"invalid size token: {size_str}")

def append_static_desc_headers(txt_file: Path) -> None:
	_BENCH_LOG_DEDUPE.clear()
	lines: List[str] = []
	lines.append("BENCH|type=desc|test=system / time|what=process runtime split|measures=user sys elapsed maxrss minflt|method=GNU time around each isolated section run|detects=runtime split and memory-fault pressure per section")
	if not IS_WINDOWS:
		lines.append("BENCH|type=desc|test=system / perf|what=counter snapshot for benchmark process|measures=task_clock page_faults syscalls|method=perf stat around each isolated section run with strace for syscall count|detects=cpu-time and syscall pressure per section")
	with open(txt_file, "w") as f:
		for line in lines:
			_BENCH_LOG_DEDUPE.add(line)
			f.write(line + "\n")

def should_keep_bench_line(line: str) -> bool:
	if line.startswith("BENCH|type=desc|") or line.startswith("BENCH|type=meta|"):
		if line in _BENCH_LOG_DEDUPE:
			return False
		_BENCH_LOG_DEDUPE.add(line)
	return True

def process_bench_logs(stderr_stream: Optional[IO[str]], log_file: Path) -> None:
	if not stderr_stream:
		return
	with open(log_file, "a") as f:
		for line in stderr_stream:
			line = line.strip()
			if line.startswith(BENCH_LOG_TAG + " "):
				msg: str = line[len(BENCH_LOG_TAG) + 1:].strip()
				if msg.startswith("type:"):
					parts: List[str] = msg.split()
					bench_line: str = "BENCH"
					for part in parts:
						if ":" in part:
							k, v = part.split(":", 1)
							bench_line += f"|{k}={v}"
					if should_keep_bench_line(bench_line):
						f.write(bench_line + "\n")
				else:
					if should_keep_bench_line(msg):
						f.write(msg + "\n")
			else:
				f.write(line + "\n")

def run_bench_worker(log_file: Path, alloc_name: str, section: str, run_bin_prefix: Path, extra_env: Dict[str, str], seed: str) -> None:
	status_line(f"running: allocator={alloc_name} section={section if section else 'all'}")
	perf_events, syscalls_available = init_perf_events()
	section_field: str = f"|section={section}" if section else ""
	time_format: str = f"BENCH|type=time{section_field}|user=%U|sys=%S|elapsed=%e|maxrss=%M|minflt=%R"

	binary_name: Optional[str] = None
	args: List[str] = [str(seed)]

	if section.startswith("rss_"):
		binary_name = "rss"
		args.append(str(parse_size_token(section[4:])))
	elif section == "reclaim":
		binary_name = "reclaim"
	elif section.startswith("frag_"):
		binary_name = "frag"
		args.append(str(parse_size_token(section[5:])))
	elif section.startswith("ops_"):
		binary_name = "ops"
		kind, size_str = section[4:].rsplit("_", 1)
		size_val: int = parse_size_token(size_str)
		args.extend([kind, str(size_val)])
	elif section.startswith("first_"):
		binary_name = "first"
		args.append(str(parse_size_token(section[6:])))
	elif section.startswith("handoff_"):
		binary_name = "handoff"
		size_val = parse_size_token(section[8:])
		if size_val == 8:
			args.extend(["postfree", "8"])
		else:
			args.extend(["foreign", str(size_val)])
	elif section == "app_mt":
		binary_name = "app_mt"
	elif section == "app_st":
		binary_name = "app_st"
	elif section.startswith("locality_"):
		binary_name = "locality"
		args.append(str(parse_size_token(section[9:])))

	if not binary_name:
		return

	run_bin: Path = Path(f"{run_bin_prefix}_{binary_name}{EXE_SUFFIX}")
	run_single_bench(log_file, run_bin, args, extra_env, perf_events, time_format, section_field, syscalls_available)

def run_single_bench(log_file: Path, run_bin: Path, args: List[str], extra_env: Dict[str, str], perf_events: str, time_format: str, section_field: str, syscalls_available: bool) -> None:
	with tempfile.TemporaryDirectory(prefix="bench_tmp_") as tmp_dir:
		tmp_path: Path = Path(tmp_dir)
		time_file: Path = tmp_path / "time.txt"
		perf_file: Path = tmp_path / "perf.txt"
		strace_file: Path = tmp_path / "strace.txt"

		if IS_WINDOWS:
			cmd: List[str] = [TIME_CMD, "-f", time_format, "-o", str(time_file), str(run_bin)]
		else:
			cmd = [TIME_CMD, "-f", time_format, "-o", str(time_file), "perf", "stat", "-x,", "-o", str(perf_file), "-e", perf_events, "--", str(run_bin)]
		cmd.extend(args)

		env: Dict[str, str] = os.environ.copy()
		env.update(extra_env)

		with subprocess.Popen(cmd, env=env, stderr=subprocess.PIPE, stdout=subprocess.DEVNULL, text=True) as proc:
			process_bench_logs(proc.stderr, log_file)

		if time_file.is_file() and time_file.stat().st_size > 0:
			with open(log_file, "a") as f_out:
				f_out.write(time_file.read_text() + "\n")

		syscalls: str = "na"
		task_clock: str = "na"
		page_faults: str = "na"

		if not IS_WINDOWS and not syscalls_available:
			syscalls = "unavailable"

		if perf_file.is_file() and perf_file.stat().st_size > 0:
			for line in perf_file.read_text().splitlines():
				parts: List[str] = line.split(",")
				if len(parts) >= 3:
					val, event = parts[0].strip(), parts[2].strip()
					if "sys_enter" in event:
						syscalls = val
					elif "task-clock" in event:
						task_clock = val
					elif "page-faults" in event:
						page_faults = val

		if not IS_WINDOWS and not syscalls_available and shutil.which("strace"):
			strace_cmd: List[str] = ["strace", "-f", "-qq", "-c", "-o", str(strace_file), "--", str(run_bin)]
			strace_cmd.extend(args)
			subprocess.run(strace_cmd, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
			if strace_file.is_file() and strace_file.stat().st_size > 0:
				for line in strace_file.read_text().splitlines():
					if " total" in line:
						parts = line.split()
						if len(parts) >= 3:
							syscalls = parts[-2]

		if not IS_WINDOWS:
			with open(log_file, "a") as f_out:
				f_out.write(f"BENCH|type=perf{section_field}|syscalls={syscalls}|task_clock={task_clock}|page_faults={page_faults}\n\n")

def run_sections_for_allocator(allocator: str, run_bin_prefix: Path, extra_env: Dict[str, str], sections: List[str], seed: str) -> None:
	with open(DEFAULT_TXT, "a") as f:
		f.write(f"\n========== {allocator} ==========\n")
	env: Dict[str, str] = extra_env.copy()
	for sec in sections:
		run_bench_worker(DEFAULT_TXT, allocator, sec, run_bin_prefix, env, seed)

def find_lib(name: str) -> Optional[str]:
	if IS_WINDOWS:
		for raw_dir in os.environ.get("PATH", "").split(os.pathsep):
			if not raw_dir:
				continue
			candidate = Path(raw_dir) / name
			if candidate.is_file():
				return str(candidate)
		return None

	try:
		res: subprocess.CompletedProcess = subprocess.run(["ldconfig", "-p"], capture_output=True, text=True)
		for line in res.stdout.splitlines():
			if name in line and "=>" in line:
				return line.split("=>")[-1].strip()
	except Exception:
		pass
	return None

def prefix_allocators(tag: str, input_path: str, output_path: str) -> None:
	lines: List[str] = []
	for line in Path(input_path).read_text().splitlines(keepends=True):
		prefix: str = ""
		if line.startswith("\n"):
			prefix = "\n"
			line = line[1:]
		if line.startswith("=========="):
			rest: str = line[10:]
			pos: int = rest.find("==========")
			if pos > 0:
				name: str = rest[:pos].strip()
				if name:
					lines.append(f"{prefix}========== {tag} / {name} ==========\n")
					continue
		lines.append(line)
	Path(output_path).write_text("".join(lines))

def extract_allocator_log(allocator_name: str, input_path: str, output_path: str) -> None:
	lines: List[str] = []
	in_target: bool = False
	seen_global: Set[str] = set()
	for line in Path(input_path).read_text().splitlines(keepends=True):
		trimmed: str = line.lstrip("\n")
		if trimmed.startswith("=========="):
			rest: str = trimmed[10:]
			pos: int = rest.find("==========")
			if pos > 0:
				name: str = rest[:pos].strip()
				in_target = (name == allocator_name)
				if in_target:
					lines.append(line)
				continue
		if trimmed.startswith("BENCH|"):
			if trimmed.startswith("BENCH|type=desc|") or trimmed.startswith("BENCH|type=meta|"):
				key: str = trimmed.strip()
				if key not in seen_global:
					seen_global.add(key)
					lines.append(line)
			elif in_target:
				lines.append(line)
	Path(output_path).write_text("".join(lines))

