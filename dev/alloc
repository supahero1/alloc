def cmd_bench_regen(args: argparse.Namespace) -> None:
	ensure_runs_dir()
	ensure_report_script()
	target: str = args.target

	report_args: List[str] = []
	if args.good_max:
		report_args.extend(["--good-max", str(args.good_max)])
	if args.focus:
		report_args.extend(["--focus", str(args.focus)])
	if args.focus_list:
		report_args.extend(["--focus-list", str(args.focus_list)])

	def do_regen(txt_path: Path, html_path: Path) -> None:
		status_line(f"running: bench_detailed_report input={txt_path.name}")
		report.main(["report", str(txt_path), str(html_path)] + report_args)

	if target == "all":
		any_found: bool = False
		for name in list_run_names():
			run_dir: Path = RUNS_DIR / name
			if (run_dir / "log.txt").is_file():
				any_found = True
				print(f"regen run: {name}")
				do_regen(run_dir / "log.txt", run_dir / "report.html")
		for name in list_comparison_bases():
			txt_path: Path = COMPARE_DIR / f"{name}.txt"
			if txt_path.is_file():
				any_found = True
				print(f"regen compare: {name}.txt")
				do_regen(txt_path, COMPARE_DIR / f"{name}.html")
		if DEFAULT_TXT.is_file():
			any_found = True
			print(f"regen default: {DEFAULT_TXT}")
			do_regen(DEFAULT_TXT, DEFAULT_HTML)
		if not any_found:
			print("no txt files found to regenerate")
		status_done()
		return

	if target == "latest":
		names: List[str] = list_run_names()
		if names:
			print(f"regen latest run: {names[0]}")
			do_regen(RUNS_DIR / names[0] / "log.txt", RUNS_DIR / names[0] / "report.html")
			status_done()
			maybe_open_html(RUNS_DIR / names[0] / "report.html", args.open)
			return
		if DEFAULT_TXT.is_file():
			print(f"regen default: {DEFAULT_TXT}")
			do_regen(DEFAULT_TXT, DEFAULT_HTML)
			status_done()
			maybe_open_html(DEFAULT_HTML, args.open)
			return
		sys.exit(f"no archived runs and no {DEFAULT_TXT} found")

	run_name: str = resolve_run_token_or_exit(target)
	print(f"regen run: {run_name}")
	html: Path = RUNS_DIR / run_name / "report.html"
	do_regen(RUNS_DIR / run_name / "log.txt", html)
	status_done()
	maybe_open_html(html, args.open)

def cmd_bench_compare(args: argparse.Namespace) -> None:
	ensure_runs_dir()
	ensure_report_script()
	run_a: str = resolve_run_token_or_exit(args.runA)
	run_b: str = resolve_run_token_or_exit(args.runB)

	txt_a: Path = RUNS_DIR / run_a / "log.txt"
	txt_b: Path = RUNS_DIR / run_b / "log.txt"
	if not txt_a.is_file(): sys.exit(f"missing {txt_a}")
	if not txt_b.is_file(): sys.exit(f"missing {txt_b}")

	stamp: str = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
	cmp_name: str = f"{stamp}_{run_a}_vs_{run_b}"
	merged_txt: Path = COMPARE_DIR / f"{cmp_name}.txt"
	cmp_html: Path = COMPARE_DIR / f"{cmp_name}.html"

	with tempfile.TemporaryDirectory() as tmp_dir:
		tmp_path: Path = Path(tmp_dir)
		tmp_a: Path = tmp_path / "a.txt"
		tmp_b: Path = tmp_path / "b.txt"
		src_a: Path = tmp_path / "src_a.txt"
		src_b: Path = tmp_path / "src_b.txt"

		extract_allocator_log(args.allocator, str(txt_a), str(src_a))
		extract_allocator_log(args.allocator, str(txt_b), str(src_b))
		prefix_allocators(f"A:{run_a}", str(src_a), str(tmp_a))
		prefix_allocators(f"B:{run_b}", str(src_b), str(tmp_b))

		merged_txt.write_text(tmp_a.read_text() + tmp_b.read_text())

		report_cmd: List[str] = ["report", str(merged_txt), str(cmp_html)]
		if args.good_max:
			report_cmd.extend(["--good-max", str(args.good_max)])
		if args.focus:
			report_cmd.extend(["--focus", str(args.focus)])
		if args.focus_list:
			report_cmd.extend(["--focus-list", str(args.focus_list)])
		status_line(f"running: bench_detailed_report compare={run_a}_vs_{run_b} allocator={args.allocator}")
		report.main(report_cmd)

	status_done()
	print(f"compare: {run_a} vs {run_b} (allocator={args.allocator})")
	print(f"txt:     {merged_txt}")
	print(f"html:    {cmp_html}")
	maybe_open_html(cmp_html, args.open)

def cmd_bench_prune(args: argparse.Namespace) -> None:
	ensure_runs_dir()

	prune_runs: bool = args.all or args.runs
	prune_comps: bool = args.all or args.comparisons
	if not args.runs and not args.comparisons and not args.all:
		prune_runs = True
		prune_comps = True

	keep: Optional[int] = args.keep
	older_than: Optional[int] = args.older_than

	if keep is None and older_than is None:
		if args.all:
			keep = 0
		else:
			keep = 1
			print("no prune criteria provided, defaulting to --keep 1")

	doomed_runs: List[Path] = []
	doomed_comps: List[Path] = []
	now: float = datetime.datetime.now().timestamp()

	if prune_runs:
		for i, name in enumerate(list_run_names()):
			run_dir: Path = RUNS_DIR / name
			remove: bool = False
			if keep is not None and (i + 1) > keep:
				remove = True
			if older_than is not None and run_dir.stat().st_mtime < (now - (older_than * 86400)):
				remove = True
			if remove:
				doomed_runs.append(run_dir)

	if prune_comps:
		for i, name in enumerate(list_comparison_bases()):
			txt: Path = COMPARE_DIR / f"{name}.txt"
			html: Path = COMPARE_DIR / f"{name}.html"
			remove = False
			if keep is not None and (i + 1) > keep:
				remove = True
			if older_than is not None:
				probe: Path = txt if txt.is_file() else html
				if probe.is_file() and probe.stat().st_mtime < (now - (older_than * 86400)):
					remove = True
			if remove:
				doomed_comps.append(txt)
				if html.is_file():
					doomed_comps.append(html)

	if not doomed_runs and not doomed_comps:
		print("nothing to prune")
		return

	if doomed_runs:
		print("runs to delete:")
		for d in doomed_runs: print(f"  - {d}")
	if doomed_comps:
		print("comparison files to delete:")
		for d in doomed_comps: print(f"  - {d}")

	if not args.yes:
		ans: str = input("continue? [y/N] ").strip().lower()
		if ans not in ("y", "yes"):
			sys.exit("aborted")

	for d in doomed_runs:
		shutil.rmtree(d, ignore_errors=True)
	for d in doomed_comps:
		if d.exists():
			d.unlink()

	print(f"deleted {len(doomed_runs)} run(s), {len(doomed_comps)} comparison file(s)")

def main() -> None:
	parser: argparse.ArgumentParser = argparse.ArgumentParser(prog="alloc", description="Allocator development script")
	subparsers: argparse._SubParsersAction = parser.add_subparsers(dest="command", required=True)

	p_chaos: argparse.ArgumentParser = subparsers.add_parser("chaos", help="Build and run chaos test")
	p_chaos.set_defaults(func=cmd_chaos)

	p_dump: argparse.ArgumentParser = subparsers.add_parser("dump", help="Dump one function with line info")
	p_dump.add_argument("function", help="Function to dump")
	p_dump.add_argument("--lib", help="Path to objdump-friendly library")
	p_dump.set_defaults(func=cmd_dump)

	p_install: argparse.ArgumentParser = subparsers.add_parser("install", help="Symlink CLI into ~/.local/bin")
	p_install.add_argument("--name", default="alloc", help="Symlink name")
	p_install.set_defaults(func=cmd_install)

	p_build: argparse.ArgumentParser = subparsers.add_parser("build", help="Build allocator libraries")
	p_build.add_argument(
		"what",
		nargs="?",
		default="all",
		choices=["all", "release", "release_objdump", "debug", "dev", "instrumented"],
		help="Build target (default: all)"
	)
	p_build.set_defaults(func=cmd_build)

	p_bench: argparse.ArgumentParser = subparsers.add_parser("bench", help="Delegate to bench manager")
	bench_sub: argparse._SubParsersAction = p_bench.add_subparsers(dest="bench_command", required=True)

	p_run: argparse.ArgumentParser = bench_sub.add_parser("run", help="Run benchmarks")
	p_run.add_argument("--label", default="run")
	p_run.add_argument("--only", help="Comma-separated sections")
	p_run.add_argument("--alloc-only", action="store_true")
	p_run.add_argument("--good-max")
	p_run.add_argument("--open", action="store_true", help="Open HTML report automatically")
	p_run.set_defaults(func=cmd_bench_run)

	p_list: argparse.ArgumentParser = bench_sub.add_parser("list", help="List archived runs")
	p_list.set_defaults(func=cmd_bench_list)

	p_show: argparse.ArgumentParser = bench_sub.add_parser("show", help="Regenerate HTML for one archived run")
	p_show.add_argument("--good-max")
	p_show.add_argument("--focus")
	p_show.add_argument("--focus-list")
	p_show.add_argument("--open", action="store_true", help="Open HTML report automatically")
	p_show.add_argument("run_token", metavar="index|name")
	p_show.set_defaults(func=cmd_bench_show)

	p_regen: argparse.ArgumentParser = bench_sub.add_parser("regen", help="Regenerate HTML from existing txt logs")
	p_regen.add_argument("--good-max")
	p_regen.add_argument("--focus")
	p_regen.add_argument("--focus-list")
	p_regen.add_argument("--open", action="store_true", help="Open HTML report automatically")
	p_regen.add_argument("target", nargs="?", default="latest")
	p_regen.set_defaults(func=cmd_bench_regen)

	p_compare: argparse.ArgumentParser = bench_sub.add_parser("compare", help="Build comparison HTML merging two archived logs")
	p_compare.add_argument("--allocator", default="alloc")
	p_compare.add_argument("--good-max")
	p_compare.add_argument("--focus")
	p_compare.add_argument("--focus-list")
	p_compare.add_argument("--open", action="store_true", help="Open HTML report automatically")
	p_compare.add_argument("runA")
	p_compare.add_argument("runB")
	p_compare.set_defaults(func=cmd_bench_compare)

	p_prune: argparse.ArgumentParser = bench_sub.add_parser("prune", help="Delete archived runs and/or comparisons")
	p_prune.add_argument("--keep", type=int)
	p_prune.add_argument("--older-than", type=int)
	p_prune.add_argument("--runs", action="store_true")
	p_prune.add_argument("--comparisons", action="store_true")
	p_prune.add_argument("--all", action="store_true")
	p_prune.add_argument("--yes", action="store_true")
	p_prune.set_defaults(func=cmd_bench_prune)

	args: argparse.Namespace = parser.parse_args()
	args.func(args)

if __name__ == "__main__":
	main()
