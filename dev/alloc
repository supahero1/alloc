def cmd_dump(args: argparse.Namespace) -> None:
	if IS_WINDOWS:
		default_lib: Path = BIN_DIR / "liballoc_release_objdump.dll"
	elif sys.platform == "darwin":
		default_lib = BIN_DIR / "liballoc_release_objdump.dylib"
	else:
		default_lib = BIN_DIR / "liballoc_release_objdump.so"

	lib_path: str = args.lib if args.lib else str(default_lib)
	if not shutil.which("objdump"):
		sys.exit("objdump not found in PATH")
	if Path(lib_path).resolve() == default_lib.resolve():
		status_line("building: liballoc_release_objdump")
		subprocess.run(["make", "-C", str(ROOT_DIR), "liballoc_release_objdump"], check=False, stdout=subprocess.DEVNULL)
	if not Path(lib_path).is_file():
		status_done()
		sys.exit(f"library not found: {lib_path}")

	start_addr: Optional[int] = None
	stop_addr: Optional[int] = None
	try:
		nm_res = subprocess.run(["nm", "-n", lib_path], capture_output=True, text=True)
		if nm_res.returncode == 0:
			symbols: List[Tuple[int, str]] = []
			for line in nm_res.stdout.splitlines():
				parts = line.split()
				if len(parts) < 3:
					continue
				try:
					addr = int(parts[0], 16)
				except ValueError:
					continue
				symbols.append((addr, parts[-1]))

			for idx, (addr, name) in enumerate(symbols):
				if name == args.function:
					start_addr = addr
					for j in range(idx + 1, len(symbols)):
						next_addr = symbols[j][0]
						if next_addr > addr:
							stop_addr = next_addr
							break
					break
	except Exception:
		pass

	status_line(f"running: objdump function={args.function}")
	objdump_cmd: List[str] = ["objdump", "-d", "-C", "-M", "intel", "--line-numbers"]
	if start_addr is not None:
		objdump_cmd.append(f"--start-address=0x{start_addr:x}")
	if stop_addr is not None:
		objdump_cmd.append(f"--stop-address=0x{stop_addr:x}")
	objdump_cmd.extend([f"--disassemble={args.function}", lib_path])
	status_run(objdump_cmd)
	status_done()

