def cmd_bench_list(args: Optional[argparse.Namespace] = None) -> None:
	ensure_runs_dir()
	names: List[str] = list_run_names()
	comparisons: List[str] = list_comparison_bases()
	if not names and not comparisons:
		print(f"no archived runs or comparisons in {RUNS_DIR}")
		return
	if names:
		print(f"{'idx':<5} {'run':<28} files")
		for i, name in enumerate(names, 1):
			run_dir: Path = RUNS_DIR / name
			files: int = sum(1 for f in ["log.txt", "report.html"] if (run_dir / f).is_file())
			print(f"{i:<5} {name:<28} {files}/2")
	if comparisons:
		if names:
			print()
		print(f"{'idx':<5} {'comparison':<56} files")
		for i, name in enumerate(comparisons, 1):
			files = sum(1 for ext in [".txt", ".html"] if (COMPARE_DIR / f"{name}{ext}").is_file())
			print(f"{i:<5} {name:<56} {files}/2")

def cmd_bench_run(args: argparse.Namespace) -> None:
	ensure_runs_dir()
	ensure_bench_bins()
	ensure_report_script()
	if not IS_WINDOWS and not shutil.which("perf"):
		sys.exit("perf is required but not found in PATH")
	if not shutil.which(TIME_CMD):
		sys.exit(f"{TIME_CMD} is required but not found")

	bench_sections: List[str] = [s.strip() for s in args.only.replace(",", " ").split() if s.strip()] if args.only else default_sections()
	if not bench_sections:
		sys.exit("no benchmark sections selected")

	status_line("building: build_dev_bench")
	subprocess.run(["make", "-C", str(ROOT_DIR), "build_dev_bench"], check=False, stdout=subprocess.DEVNULL)
	append_static_desc_headers(DEFAULT_TXT)

	seed: str = os.environ.get("BENCH_SEED", str(random.randint(1, 2**31 - 1)))
	other_bin: Path = BIN_DIR / "bench_detailed_other"
	alloc_bin: Path = BIN_DIR / "bench_detailed_alloc"
	default_allocator_name: str = "system" if IS_WINDOWS else "pt2malloc"

	if not args.alloc_only:
		run_sections_for_allocator(default_allocator_name, other_bin, {}, bench_sections, seed)

		if IS_WINDOWS:
			if find_lib("libjemalloc.dll"):
				run_sections_for_allocator("jemalloc", BIN_DIR / "bench_detailed_jemalloc", {}, bench_sections, seed)
			else:
				with open(DEFAULT_TXT, "a") as f:
					f.write("BENCH|type=meta|allocator=jemalloc|status=skipped|reason=unavailable\n\n")

			if find_lib("libmimalloc.dll"):
				run_sections_for_allocator("mimalloc", BIN_DIR / "bench_detailed_mimalloc", {}, bench_sections, seed)
			else:
				with open(DEFAULT_TXT, "a") as f:
					f.write("BENCH|type=meta|allocator=mimalloc|status=skipped|reason=unavailable\n\n")

			if find_lib("libtbbmalloc_proxy.dll") and find_lib("libtbbmalloc.dll"):
				run_sections_for_allocator("tbbmalloc", BIN_DIR / "bench_detailed_tbbmalloc", {}, bench_sections, seed)
			else:
				with open(DEFAULT_TXT, "a") as f:
					f.write("BENCH|type=meta|allocator=tbbmalloc|status=skipped|reason=unavailable\n\n")
		else:
			jemalloc: Optional[str] = find_lib("libjemalloc.so")
			if jemalloc:
				run_sections_for_allocator("jemalloc", other_bin, {"LD_PRELOAD": jemalloc}, bench_sections, seed)

			mimalloc: Optional[str] = find_lib("libmimalloc.so")
			if mimalloc:
				run_sections_for_allocator("mimalloc", other_bin, {"LD_PRELOAD": mimalloc}, bench_sections, seed)

			tcmalloc: Optional[str] = find_lib("libtcmalloc_minimal.so")
			if tcmalloc:
				run_sections_for_allocator("tcmalloc", other_bin, {"LD_PRELOAD": tcmalloc}, bench_sections, seed)

			tbb_proxy: Optional[str] = find_lib("libtbbmalloc_proxy.so")
			tbb_base: Optional[str] = find_lib("libtbbmalloc.so")
			tbb_preload: Optional[str] = tbb_proxy if tbb_proxy else tbb_base
			if tbb_preload and subprocess.run(["/bin/true"], env={"LD_PRELOAD": tbb_preload}, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
				run_sections_for_allocator("tbbmalloc", other_bin, {"LD_PRELOAD": tbb_preload}, bench_sections, seed)
			else:
				print("tbbmalloc preload unavailable, skipping", file=sys.stderr)
				with open(DEFAULT_TXT, "a") as f:
					f.write("BENCH|type=meta|allocator=tbbmalloc|status=skipped|reason=preload_unavailable\n\n")

	alloc_env: Dict[str, str] = {
		"LD_LIBRARY_PATH": f"{BIN_DIR}:{os.environ.get('LD_LIBRARY_PATH', '')}",
		"DYLD_LIBRARY_PATH": f"{BIN_DIR}:{os.environ.get('DYLD_LIBRARY_PATH', '')}"
	}
	run_sections_for_allocator("alloc", alloc_bin, alloc_env, bench_sections, seed)

	report_cmd: List[str] = ["report", str(DEFAULT_TXT), str(DEFAULT_HTML)]
	if args.good_max:
		report_cmd.extend(["--good-max", str(args.good_max)])
	status_line("running: bench_detailed_report")
	report.main(report_cmd)

	if not DEFAULT_TXT.is_file() or not DEFAULT_HTML.is_file():
		sys.exit("missing log or html output after run")

	stamp: str = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
	run_name: str = f"{stamp}_{sanitize_label(args.label)}"
	run_dir: Path = RUNS_DIR / run_name
	run_dir.mkdir(parents=True, exist_ok=True)

	shutil.copy2(DEFAULT_TXT, run_dir / "log.txt")
	shutil.copy2(DEFAULT_HTML, run_dir / "report.html")

	git_head: str = ""
	try:
		git_head = subprocess.run(["git", "-C", str(ROOT_DIR), "rev-parse", "--short", "HEAD"], capture_output=True, text=True).stdout.strip()
	except Exception:
		pass

	with open(run_dir / "meta.env", "w") as f:
		f.write(f"name={run_name}\ncreated_at={datetime.datetime.now().isoformat()}\n")
		f.write(f"target={'bench_detailed_alloc_only' if args.alloc_only else 'bench_detailed'}\n")
		f.write(f"bench_only={args.only if args.only else ''}\nalloc_only={1 if args.alloc_only else 0}\n")
		f.write(f"good_max={args.good_max if args.good_max else ''}\ngit_head={git_head}\n")

	status_done()
	print(f"archived run: {run_name}")
	print(f"log:  {run_dir / 'log.txt'}")
	print(f"html: {run_dir / 'report.html'}")
	maybe_open_html(run_dir / "report.html", args.open)

